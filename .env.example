# ─── Supabase ─────────────────────────────────────────────────────────────
# Projeto "Arium" — as tabelas vivem no schema `manychat`
SUPABASE_URL=
# Pegue em: Supabase → Project Settings → API Keys → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

# ─── Meta / Instagram ─────────────────────────────────────────────────────
# App do Meta → Configurações → Básico
META_APP_ID=
META_APP_SECRET=
# Você inventa essa string. Vai colar a MESMA no painel de webhook do Meta.
META_VERIFY_TOKEN=troque-isto-por-uma-string-aleatoria
# Token de acesso de longa duração da conta Instagram
IG_ACCESS_TOKEN=
# ID numérico da conta IG (o app descobre sozinho se deixar vazio)
IG_USER_ID=

# ─── Dashboard ────────────────────────────────────────────────────────────
# Senha para entrar no painel
DASHBOARD_PASSWORD=
# Segredo para assinar o cookie de sessão (string longa e aleatória)
AUTH_SECRET=
