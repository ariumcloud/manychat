# ─── Supabase ─────────────────────────────────────────────────────────────
# Projeto "Arium" — as tabelas vivem no schema `manychat`
SUPABASE_URL=
# Pegue em: Supabase → Project Settings → API Keys → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

# ─── Meta / Instagram ─────────────────────────────────────────────────────
# App do Meta → Configurações → Básico
META_APP_ID=
META_APP_SECRET=
# Você inventa essa string. Vai colar a MESMA no painel de webhook do Meta.
META_VERIFY_TOKEN=troque-isto-por-uma-string-aleatoria
# Token da conta original (a do dono), de antes do OAuth. Contas conectadas pelo
# botão "Conectar Instagram" guardam o token delas no banco e NÃO usam este.
IG_ACCESS_TOKEN=
# ID numérico da conta IG original (o app descobre sozinho se deixar vazio)
IG_USER_ID=
# Conectar Instagram por OAuth (Instagram Login). Só preencha se o app do
# Instagram tiver ID/segredo diferentes de META_APP_ID/META_APP_SECRET
# (Meta → Instagram → Configuração da API com login do Instagram).
IG_APP_ID=
IG_APP_SECRET=
# Domínio público do app, ex.: https://seuapp.com. Precisa estar cadastrado na
# Meta como URI de redirecionamento: <APP_BASE_URL>/api/instagram/callback
APP_BASE_URL=

# ─── Dashboard ────────────────────────────────────────────────────────────
# Senha para entrar no painel
DASHBOARD_PASSWORD=
# Segredo para assinar o cookie de sessão (string longa e aleatória)
AUTH_SECRET=
# Domínio público deste app, ex.: https://seuapp.com — é a base dos links
# rastreados (/r/<token>) que vão nos botões da DM. Na Vercel o app descobre
# sozinho. Vazio fora da Vercel = botão com o link original, sem medição.
LINK_TRACKING_BASE_URL=

# ─── Carrosséis (opcional) ────────────────────────────────────────────────
# Quem escreve o roteiro dos slides. Deixe vazio para escolher sozinho pela
# chave que existir. Valores: openai | anthropic
AI_PROVIDER=

# OpenAI — pegue em platform.openai.com
OPENAI_API_KEY=
# Default e o mais barato. Suba para terra ou sol se a copy sair generica.
# gpt-5.6-luna | gpt-5.6-terra | gpt-5.6-sol
OPENAI_MODEL=

# Anthropic — pegue em console.anthropic.com
ANTHROPIC_API_KEY=
